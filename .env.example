# EPIC-002 — environment template. Copy to `.env` and fill real values.
# The `.env` file is git-ignored. NEVER commit real secrets.

# --- Postgres ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=inventory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_HOST=redis
REDIS_PORT=6379

# --- API ---
ASPNETCORE_URLS=http://0.0.0.0:3001
ASPNETCORE_ENVIRONMENT=Production

# --- JWT auth (EPIC-002 M4) ---
# Must be >= 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_ISSUER=inventory-mgmt
JWT_AUDIENCE=inventory-mgmt-web
JWT_EXPIRY_HOURS=8

# --- Default admin seed (only used on first boot when users table is empty) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login

# --- Excel migration (EPIC-002 M3) ---
LEGACY_INVENTORY_FILE=/data/inventory.xlsx

# --- EPIC-003 ---
# CORS allow-list. Comma-separated origins. Defaults to localhost dev origins if unset
# (the api will refuse wildcard '*'). In production set the real domain(s).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Kill-switch — DO NOT enable in production. Bypasses Redis session check.
# Scheduled for removal 7 days after EPIC-003 Slice 1 GA.
# DISABLE_REDIS_SESSION_CHECK=false

# Permission enforcement feature flag (EPIC-003 S4).
# Default true. If "false", policies fall back to authenticated-only (legacy behavior).
# Scheduled for removal 14 days after S4 GA.
PERMISSION_ENFORCEMENT_ENABLED=true
